#!/bin/bash

# ========================================
# SK-Coder v2.0 - Secrets Template
# ========================================
# INSTRUKCJA:
# 1. Skopiuj ten plik: cp devops/secrets.sh.example devops/secrets.sh
# 2. Uzupełnij prawdziwe tokeny w devops/secrets.sh
# 3. NIE COMMITUJ devops/secrets.sh do Git!
# ========================================

# Hugging Face Token (write access)
# Pobierz z: https://huggingface.co/settings/tokens
export HF_TOKEN="WKLEJ_TU_TOKEN_WRITE"

# Ngrok Token
# Pobierz z: https://dashboard.ngrok.com/get-started/your-authtoken
export NGROK_TOKEN="WKLEJ_TU_TOKEN"

# Weights & Biases API Key
# Pobierz z: https://wandb.ai/authorize
export WANDB_API_KEY="WKLEJ_TU_KLUCZ_WANDB"
